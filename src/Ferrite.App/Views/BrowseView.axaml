<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Ferrite.App.ViewModels"
             xmlns:ct="clr-namespace:Ferrite.Core.Content;assembly=Ferrite.Core"
             xmlns:controls="clr-namespace:Ferrite.App.Controls"
             x:Class="Ferrite.App.Views.BrowseView"
             x:DataType="vm:BrowseViewModel">

  <Grid RowDefinitions="Auto,Auto,*" Margin="24">

    <!-- Search and the view switch -->
    <WrapPanel Grid.Row="0" Orientation="Horizontal" ItemHeight="34" Margin="0,0,0,12">
      <TextBox Width="380" Margin="0,0,10,10" Text="{Binding SearchText}"
               PlaceholderText="{Binding SearchPlaceholder}"
               AutomationProperties.Name="{Binding SearchPlaceholder}" />
      <Button Classes="primary" Margin="0,0,10,10" VerticalAlignment="Center"
              Content="{DynamicResource L.Browse.Search}" Command="{Binding SearchCommand}" />

      <TextBlock Classes="faint" VerticalAlignment="Center" Margin="4,0,12,10"
                 TextWrapping="NoWrap" Text="{Binding ResultSummary}" />

      <Border Margin="0,0,0,10" CornerRadius="{DynamicResource RadiusSm}"
              Background="{DynamicResource FerriteSurfaceSunken}"
              BorderBrush="{DynamicResource FerriteBorder}" BorderThickness="1"
              VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Button Classes="segment" Content="{DynamicResource L.Browse.SearchResults}"
                  Classes.active="{Binding IsSearchView}"
                  Command="{Binding ShowSearchCommand}" />
          <Button Classes="segment" Content="{DynamicResource L.Browse.Saved}"
                  Classes.active="{Binding IsSavedView}"
                  Command="{Binding ShowSavedCommand}" />
        </StackPanel>
      </Border>
    </WrapPanel>

    <!-- Facets -->
    <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,14">
      <WrapPanel Orientation="Horizontal">
        <StackPanel Spacing="4" Margin="0,0,10,0">
          <TextBlock Classes="label" Text="{DynamicResource L.Browse.FieldProvider}" />
          <ComboBox Width="150" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                    AutomationProperties.Name="{DynamicResource L.Browse.FieldProvider}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Spacing="4" Margin="0,0,10,0">
          <TextBlock Classes="label" Text="{DynamicResource L.Browse.FieldProjectType}" />
          <ComboBox Width="140" ItemsSource="{Binding ProjectTypes}" SelectedItem="{Binding SelectedProjectType}"
                    AutomationProperties.Name="{DynamicResource L.Browse.FieldProjectType}" />
        </StackPanel>
        <StackPanel Spacing="4" Margin="0,0,10,0">
          <TextBlock Classes="label" Text="{DynamicResource L.Browse.FieldCategory}" />
          <ComboBox Width="170" ItemsSource="{Binding CategoryChoices}" SelectedItem="{Binding SelectedCategory}"
                    AutomationProperties.Name="{DynamicResource L.Browse.FieldCategory}">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="ct:ContentTag">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Spacing="4" Margin="0,0,10,0">
          <TextBlock Classes="label" Text="{DynamicResource L.Browse.FieldMinecraftVersion}" />
          <ComboBox Width="150" ItemsSource="{Binding GameVersionChoices}"
                    SelectedItem="{Binding SelectedGameVersion}"
                    AutomationProperties.Name="{DynamicResource L.Browse.FieldMinecraftVersion}">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="ct:ContentTag">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Spacing="4" Margin="0,0,10,0">
          <TextBlock Classes="label" Text="{DynamicResource L.Browse.FieldLoader}" />
          <ComboBox Width="130" ItemsSource="{Binding LoaderChoices}" SelectedItem="{Binding SelectedLoader}"
                    AutomationProperties.Name="{DynamicResource L.Browse.FieldLoader}">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="ct:ContentTag">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="{DynamicResource L.Browse.FieldSort}" />
          <ComboBox Width="150" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                    AutomationProperties.Name="{DynamicResource L.Browse.FieldSort}" />
        </StackPanel>
      </WrapPanel>

      <StackPanel Spacing="2">
        <TextBlock Classes="faint" TextWrapping="Wrap" Text="{Binding StatusNote}"
                   IsVisible="{Binding StatusNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Classes="faint" TextWrapping="Wrap" Text="{Binding CacheNote}"
                   IsVisible="{Binding CacheNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Classes="faint" TextWrapping="Wrap" Text="{Binding ProviderNote}"
                   IsVisible="{Binding ProviderNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </StackPanel>

    <!-- Results and detail -->
    <Grid Grid.Row="2" ColumnDefinitions="2*,3*" ColumnSpacing="18">

      <Border Grid.Column="0" Classes="panel" Padding="6">
        <Grid>
          <ListBox Classes="results" ItemsSource="{Binding Results}"
                   SelectedItem="{Binding SelectedResult}"
                   Background="{DynamicResource FerriteClear}" BorderThickness="0" Padding="0">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="ct:ContentSummary">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                  <Border Grid.Column="0" Width="38" Height="38"
                          CornerRadius="{DynamicResource RadiusSm}"
                          Background="{DynamicResource FerriteSurfaceRaised}">
                    <controls:IconGlyph Data="{StaticResource Icon.Content}" Width="17" Height="17"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Title}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                    <TextBlock Classes="faint" Text="{Binding Description}" MaxLines="2"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Classes="faint" Text="{Binding Author}" TextWrapping="NoWrap" />
                      <TextBlock Classes="faint"
                                 Text="{Binding Downloads, StringFormat='{}{0:N0} downloads'}" />
                      <TextBlock Classes="faint" Text="{Binding ProjectType}" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                      MaxWidth="380" IsVisible="{Binding !HasResults}">
            <controls:IconGlyph Data="{StaticResource Icon.Discover}" Width="28" Height="28"
                                Opacity="0.5" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" TextAlignment="Center" Text="{Binding EmptyMessage}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Nothing selected -->
      <Border Grid.Column="1" Classes="panel" IsVisible="{Binding !HasSelection}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" MaxWidth="380">
          <controls:IconGlyph Data="{StaticResource Icon.Search}" Width="28" Height="28"
                              Opacity="0.5" HorizontalAlignment="Center" />
          <TextBlock Classes="muted" TextAlignment="Center"
                     Text="{DynamicResource L.Browse.SelectProject}" />
        </StackPanel>
      </Border>

      <!-- Project detail -->
      <Border Grid.Column="1" Classes="panel" Padding="0" IsVisible="{Binding HasSelection}">
        <Grid RowDefinitions="Auto,*,Auto">

          <!-- Hero -->
          <Border Grid.Row="0" Padding="18" CornerRadius="8,8,0,0"
                  Background="{DynamicResource FerriteSurfaceRaised}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
              <Border Grid.Column="0" Width="64" Height="64"
                      CornerRadius="{DynamicResource RadiusMd}" ClipToBounds="True"
                      Background="{DynamicResource FerriteSurfaceSunken}">
                <Panel>
                  <controls:IconGlyph Data="{StaticResource Icon.Content}" Width="26" Height="26"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Image Source="{Binding ProjectIcon}" Stretch="UniformToFill"
                         IsVisible="{Binding HasProjectIcon}" />
                </Panel>
              </Border>
              <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                <TextBlock Classes="h1" Text="{Binding SelectedResult.Title}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding SelectedResult.Title}" />
                <TextBlock Classes="meta" Text="{Binding SelectedResult.Description}"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="badge plain">
                    <TextBlock Text="{Binding SelectedResult.ProjectType}" />
                  </Border>
                  <Border Classes="badge plain">
                    <TextBlock Text="{Binding SelectedResult.Provider}" />
                  </Border>
                  <TextBlock Classes="faint" VerticalAlignment="Center"
                             Text="{Binding SelectedResult.Author}" TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Body -->
          <ScrollViewer Grid.Row="1" Padding="18">
            <StackPanel Spacing="18">

              <!-- Install -->
              <StackPanel Spacing="10">
                <TextBlock Classes="label" Text="{DynamicResource L.Browse.InstallInto}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding Instances}" SelectedItem="{Binding TargetInstance}"
                            AutomationProperties.Name="{DynamicResource L.Browse.InstallInto}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="1" Classes="ghost" Content="{DynamicResource L.Browse.RefreshInstances}"
                          Command="{Binding RefreshInstancesCommand}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <StackPanel Grid.Column="0" Spacing="5">
                    <TextBlock Classes="label" Text="{DynamicResource L.Browse.FieldVersion}" />
                    <ComboBox HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                              AutomationProperties.Name="{DynamicResource L.Browse.FieldVersion}"
                              ToolTip.Tip="{Binding SelectedVersion.Changelog}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding VersionNumber}" />
                            <TextBlock Classes="faint" Text="{Binding VersionType}" />
                          </StackPanel>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <CheckBox Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,5"
                            Content="{DynamicResource L.Browse.IncludeOptional}"
                            IsChecked="{Binding IncludeOptionalDependencies}" />
                </Grid>
              </StackPanel>

              <Border Classes="divider" />

              <StackPanel Spacing="6" IsVisible="{Binding HasProjectMeta}">
                <TextBlock Classes="label" Text="{DynamicResource L.Browse.About}" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding ProjectMeta}" />
              </StackPanel>

              <StackPanel Spacing="6" IsVisible="{Binding HasProjectBody}">
                <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding ProjectBody}" />
              </StackPanel>

              <StackPanel Spacing="8" IsVisible="{Binding HasGallery}">
                <TextBlock Classes="label" Text="{DynamicResource L.Browse.Gallery}" />
                <ItemsControl ItemsSource="{Binding Gallery}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:GalleryImageViewModel">
                      <Border Width="220" Margin="0,0,10,10"
                              CornerRadius="{DynamicResource RadiusMd}" ClipToBounds="True"
                              Background="{DynamicResource FerriteSurfaceRaised}">
                        <StackPanel Spacing="6">
                          <Panel Height="124" Background="{DynamicResource FerriteSurfaceSunken}">
                            <controls:IconGlyph Data="{StaticResource Icon.Image}" Width="22" Height="22"
                                                Opacity="0.4"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Image}" Stretch="UniformToFill"
                                   IsVisible="{Binding HasImage}" />
                          </Panel>
                          <TextBlock Classes="faint" Margin="10,0,10,10" Text="{Binding Note}"
                                     TextWrapping="Wrap" MaxLines="2"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Classes="label" Text="{DynamicResource L.Browse.Changelog}" />
                <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding SelectedVersion.Changelog}" />
                <TextBlock Classes="faint" Text="{DynamicResource L.Browse.NoChangelog}"
                           IsVisible="{Binding SelectedVersion.Changelog, Converter={x:Static ObjectConverters.IsNull}}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <!-- Actions -->
          <Border Grid.Row="2" Padding="18,14" CornerRadius="0,0,8,8"
                  BorderBrush="{DynamicResource FerriteDivider}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding SavedButtonText}" Command="{Binding ToggleSavedCommand}" />
                <Button Content="{DynamicResource L.Browse.OpenProjectPage}"
                        Command="{Binding OpenProjectPageCommand}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="{DynamicResource L.Browse.Install}"
                        IsEnabled="{Binding CanInstall}" Command="{Binding InstallCommand}" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>

  </Grid>

</UserControl>
