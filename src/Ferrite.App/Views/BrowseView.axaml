<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Ferrite.App.ViewModels"
             xmlns:ct="clr-namespace:Ferrite.Core.Content;assembly=Ferrite.Core"
             x:Class="Ferrite.App.Views.BrowseView"
             x:DataType="vm:BrowseViewModel">

  <Grid RowDefinitions="Auto,*" Margin="24">

    <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,16">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
        <TextBox Grid.Column="0" PlaceholderText="{Binding SearchPlaceholder}"
                 Text="{Binding SearchText}" />
        <Button Grid.Column="1" Classes="primary" Content="{DynamicResource L.Browse.Search}" Command="{Binding SearchCommand}" />
        <Button Grid.Column="2" Content="{DynamicResource L.Browse.RefreshInstances}" Command="{Binding RefreshInstancesCommand}" />
        <Button Grid.Column="3" Classes="chip" VerticalAlignment="Center"
                Content="{DynamicResource L.Browse.Saved}" IsVisible="{Binding IsSearchView}"
                Command="{Binding ShowSavedCommand}" />
        <Button Grid.Column="4" Classes="chip" VerticalAlignment="Center"
                Content="{DynamicResource L.Browse.SearchResults}" IsVisible="{Binding IsSavedView}"
                Command="{Binding ShowSearchCommand}" />
      </Grid>

      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="10">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Classes="label" Text="{DynamicResource L.Browse.FieldProvider}" />
          <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" Width="150">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Classes="label" Text="{DynamicResource L.Browse.FieldProjectType}" />
          <ComboBox ItemsSource="{Binding ProjectTypes}" SelectedItem="{Binding SelectedProjectType}" Width="130" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="4">
          <TextBlock Classes="label" Text="{DynamicResource L.Browse.FieldSort}" />
          <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" Width="130" />
        </StackPanel>
        <StackPanel Grid.Column="3" Spacing="4">
          <TextBlock Classes="label" Text="{DynamicResource L.Browse.FieldCategory}" />
          <ComboBox ItemsSource="{Binding CategoryChoices}" SelectedItem="{Binding SelectedCategory}" Width="170">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="ct:ContentTag">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="4" Spacing="4">
          <TextBlock Classes="label" Text="{DynamicResource L.Browse.FieldMinecraftVersion}" />
          <ComboBox ItemsSource="{Binding GameVersionChoices}" SelectedItem="{Binding SelectedGameVersion}" Width="150">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="ct:ContentTag">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="5" Spacing="4">
          <TextBlock Classes="label" Text="{DynamicResource L.Browse.FieldLoader}" />
          <ComboBox ItemsSource="{Binding LoaderChoices}" SelectedItem="{Binding SelectedLoader}" Width="130">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="ct:ContentTag">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <TextBlock Grid.Column="6" Classes="faint" VerticalAlignment="Bottom" Margin="0,0,0,6"
                   Text="{Binding ResultSummary}" />
      </Grid>

      <StackPanel Spacing="2">
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding StatusNote}"
                   IsVisible="{Binding StatusNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Classes="faint" TextWrapping="Wrap" Text="{Binding CacheNote}"
                   IsVisible="{Binding CacheNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Classes="faint" TextWrapping="Wrap" Text="{Binding ProviderNote}"
                   IsVisible="{Binding ProviderNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="2*,3*" ColumnSpacing="16">

      <Border Grid.Column="0" Classes="card" Padding="8">
        <Grid>
          <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
                   Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="2" Margin="4,6">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Classes="faint" Text="{Binding Description}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Classes="faint" Text="{Binding Author}" />
                    <TextBlock Classes="faint" Text="{Binding Downloads, StringFormat='{}{0:N0} downloads'}" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Classes="muted" Margin="12" VerticalAlignment="Top"
                     IsVisible="{Binding !HasResults}"
                     Text="{Binding EmptyMessage}" />
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card" IsVisible="{Binding HasSelection}">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
          <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Classes="h2" Text="{Binding SelectedResult.Title}" />
            <TextBlock Classes="muted" Text="{Binding SelectedResult.Description}" />
            <TextBlock Classes="faint" Text="{Binding SelectedResult.ProjectType}" />
          </StackPanel>

          <StackPanel Grid.Row="1" Spacing="8">
            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="{DynamicResource L.Browse.InstallInto}" />
              <ComboBox ItemsSource="{Binding Instances}" SelectedItem="{Binding TargetInstance}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="{DynamicResource L.Browse.FieldVersion}" />
              <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding VersionNumber}" />
                      <TextBlock Classes="faint" Text="{Binding VersionType}" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <CheckBox Content="{DynamicResource L.Browse.IncludeOptional}"
                      IsChecked="{Binding IncludeOptionalDependencies}" />
          </StackPanel>

          <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="14">
              <StackPanel Spacing="4" IsVisible="{Binding HasProjectMeta}">
                <TextBlock Classes="label" Text="{DynamicResource L.Browse.About}" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding ProjectMeta}" />
              </StackPanel>

              <StackPanel Spacing="4" IsVisible="{Binding HasProjectBody}">
                <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding ProjectBody}" />
              </StackPanel>

              <StackPanel Spacing="6" IsVisible="{Binding HasGallery}">
                <TextBlock Classes="label" Text="{DynamicResource L.Browse.Gallery}" />
                <ItemsControl ItemsSource="{Binding Gallery}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:GalleryImageViewModel">
                      <Border Classes="card" Width="200" Margin="0,0,10,10">
                        <StackPanel Spacing="4">
                          <Image Source="{Binding Image}" Height="110" Stretch="Uniform"
                                 IsVisible="{Binding HasImage}" />
                          <TextBlock Classes="faint" Text="{Binding Note}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="{DynamicResource L.Browse.Changelog}" />
                <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding SelectedVersion.Changelog}" />
                <TextBlock Classes="faint" Text="{DynamicResource L.Browse.NoChangelog}"
                           IsVisible="{Binding SelectedVersion.Changelog, Converter={x:Static ObjectConverters.IsNull}}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{Binding SavedButtonText}" Command="{Binding ToggleSavedCommand}" />
            <Button Content="{DynamicResource L.Browse.OpenProjectPage}" Command="{Binding OpenProjectPageCommand}" />
            <Button Classes="primary" Content="{DynamicResource L.Browse.Install}" IsEnabled="{Binding CanInstall}"
                    Command="{Binding InstallCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card" IsVisible="{Binding !HasSelection}">
        <TextBlock Classes="muted" VerticalAlignment="Center" HorizontalAlignment="Center"
                   Text="{DynamicResource L.Browse.SelectProject}" />
      </Border>

    </Grid>

  </Grid>

</UserControl>
