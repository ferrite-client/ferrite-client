<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Ferrite.App.ViewModels"
             x:Class="Ferrite.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

  <Grid RowDefinitions="Auto,*,Auto" Margin="24">

    <Grid Grid.Row="0" ColumnDefinitions="*,200,Auto,Auto" ColumnSpacing="12" Margin="0,0,0,16">
        <TextBox Grid.Column="0" PlaceholderText="{DynamicResource L.Library.SearchInstances}" Text="{Binding SearchText}" />
        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding SortChoices}"
                  SelectedItem="{Binding SelectedSort}">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="vm:ChoiceOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="2" Content="{DynamicResource L.Library.ImportModpack}" Click="OnImportModpackClick" />
        <Button Grid.Column="3" Classes="primary" Content="{DynamicResource L.Library.NewInstance}"
              Command="{Binding OpenCreateCommand}" />
    </Grid>

    <ScrollViewer Grid.Row="1">
      <ItemsControl ItemsSource="{Binding VisibleInstances}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:InstanceCardViewModel">
            <Border Classes="card" Margin="0,0,0,10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Classes="h2" Text="{Binding Name}" />
                  <TextBlock Classes="muted" Text="{Binding Subtitle}" />
                  <TextBlock Classes="faint" Text="{Binding ModpackText}" IsVisible="{Binding HasModpack}" />
                  <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,0">
                    <TextBlock Classes="faint" Text="{Binding MemoryText}" />
                    <TextBlock Classes="faint" Text="{Binding SizeText}" />
                    <TextBlock Classes="faint" Text="{Binding LastPlayedText}" />
                  </StackPanel>
                  <TextBlock Classes="faint" Text="{Binding StatusNote}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
            <Button Classes="primary" Content="{DynamicResource L.Library.Play}" IsVisible="{Binding !IsRunning}"
                          Command="{Binding PlayCommand}" />
            <Button Content="{DynamicResource L.Library.Stop}" IsVisible="{Binding IsRunning}" Command="{Binding StopCommand}" />
            <Button Content="{DynamicResource L.Library.Manage}" Command="{Binding OpenCommand}" />
            <Button Content="{DynamicResource L.Library.Rename}" Command="{Binding RenameCommand}" />
            <Button Content="{DynamicResource L.Library.Clone}" Command="{Binding CloneCommand}" />
            <Button Content="{DynamicResource L.Common.Folder}" Command="{Binding OpenFolderCommand}" />
            <Button Content="{DynamicResource L.Common.Repair}" Command="{Binding RepairCommand}" />
            <Button Content="{DynamicResource L.Common.Delete}" Classes="danger" Command="{Binding DeleteCommand}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock Grid.Row="1" Classes="muted" Margin="0,24,0,0" VerticalAlignment="Top"
               IsVisible="{Binding !HasInstances}"
                     Text="{DynamicResource L.Library.Empty}" />

    <TextBlock Grid.Row="2" Classes="muted" Text="{Binding ModpackStatus}" />

    <!-- Rename prompt -->
    <Border Grid.Row="0" Grid.RowSpan="3" Margin="-24" Padding="24"
            Background="{DynamicResource FerriteSurface}" IsVisible="{Binding IsRenaming}">
      <Border Classes="card" MaxWidth="440" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="12">
              <TextBlock Classes="h2" Text="{DynamicResource L.Library.RenameTitle}" />
          <TextBox Text="{Binding RenameName}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="{DynamicResource L.Common.Cancel}" Command="{Binding CancelRenameCommand}" />
              <Button Classes="primary" Content="{DynamicResource L.Library.Rename}" Command="{Binding ConfirmRenameCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Clone prompt -->
    <Border Grid.Row="0" Grid.RowSpan="3" Margin="-24" Padding="24"
            Background="{DynamicResource FerriteSurface}" IsVisible="{Binding IsCloning}">
      <Border Classes="card" MaxWidth="440" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="12">
              <TextBlock Classes="h2" Text="{DynamicResource L.Library.CloneTitle}" />
          <TextBlock Classes="muted"
                     Text="{DynamicResource L.Library.CloneHint}" />
          <TextBox Text="{Binding CloneName}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="{DynamicResource L.Common.Cancel}" Command="{Binding CancelCloneCommand}" />
              <Button Classes="primary" Content="{DynamicResource L.Library.Clone}" Command="{Binding ConfirmCloneCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Creation form -->
    <Border Grid.Row="0" Grid.RowSpan="3" Margin="-24" Padding="24"
            Background="{DynamicResource FerriteSurface}" IsVisible="{Binding IsCreating}">
      <Border Classes="card" MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="14">
              <TextBlock Classes="h2" Text="{DynamicResource L.Library.CreateTitle}" />

          <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="{DynamicResource L.Library.FieldName}" />
            <TextBox Text="{Binding NewName}" />
          </StackPanel>

          <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="{DynamicResource L.Library.FieldMinecraftVersion}" />
            <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding NewVersion}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Id}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <CheckBox Content="{DynamicResource L.Library.ShowSnapshots}" IsChecked="{Binding ShowSnapshots}" />
          </StackPanel>

          <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="{DynamicResource L.Library.FieldLoader}" />
            <ComboBox ItemsSource="{Binding LoaderOptions}" SelectedItem="{Binding NewLoader}"
                      HorizontalAlignment="Stretch" />
          </StackPanel>

          <StackPanel Spacing="4" IsVisible="{Binding NeedsLoaderVersion}">
              <TextBlock Classes="label" Text="{DynamicResource L.Library.FieldLoaderVersion}" />
            <ComboBox ItemsSource="{Binding LoaderVersions}" SelectedItem="{Binding NewLoaderVersion}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Version}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <TextBlock Text="{Binding FormError}" Foreground="{DynamicResource FerriteDanger}"
                     IsVisible="{Binding HasFormError}" />

          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="{DynamicResource L.Common.Cancel}" Command="{Binding CancelCreateCommand}" />
              <Button Classes="primary" Content="{DynamicResource L.Library.CreateAndInstall}" Command="{Binding CreateCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

  </Grid>

</UserControl>
