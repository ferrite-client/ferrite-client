<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Ferrite.App.ViewModels"
             xmlns:controls="clr-namespace:Ferrite.App.Controls"
             x:Class="Ferrite.App.Views.InstanceDetailView"
             x:DataType="vm:InstanceDetailViewModel">

  <Grid RowDefinitions="Auto,*,Auto" Margin="24">

    <!--
      Hero. Artwork sits behind the text and is dimmed by a surface wash rather than a fixed colour, so
      the same markup stays readable in both themes. Play is the only filled control here; everything
      else is a quiet secondary action.
    -->
    <Border Grid.Row="0" MinHeight="184" CornerRadius="{DynamicResource RadiusLg}"
            ClipToBounds="True"
            Background="{DynamicResource FerriteSurfaceRaised}"
            BorderBrush="{DynamicResource FerriteBorder}" BorderThickness="1">
      <Panel>
        <Image Source="{Binding ThemeBackgroundImage}" Stretch="UniformToFill"
               IsVisible="{Binding HasThemeBackground}" />
        <Border Background="{DynamicResource FerriteSurface}" Opacity="0.78"
                IsVisible="{Binding HasThemeBackground}" />
        <Border Background="{Binding ThemeAccentBrush}" Opacity="0.14"
                IsVisible="{Binding HasThemeAccent}" />

        <Grid Margin="24,20,20,20" ColumnDefinitions="*,Auto" ColumnSpacing="24">
          <StackPanel Grid.Column="0" Spacing="10" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="ghost icon-button sm"
                      AutomationProperties.Name="{DynamicResource L.Instance.Back}"
                      ToolTip.Tip="{DynamicResource L.Instance.Back}"
                      Command="{Binding BackCommand}">
                <controls:IconGlyph Data="{StaticResource Icon.ChevronLeft}" Width="14" Height="14" />
              </Button>
              <TextBlock Classes="faint" VerticalAlignment="Center"
                         Text="{DynamicResource L.Nav.Library}" />
            </StackPanel>

            <TextBlock Classes="display" Text="{Binding Name}"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Name}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="badge plain">
                <TextBlock Text="{Binding Record.MinecraftVersion}" />
              </Border>
              <Border Classes="badge plain">
                <TextBlock Text="{Binding LoaderText}" />
              </Border>
              <Border Classes="badge accent" IsVisible="{Binding HasPack}" MaxWidth="260">
                <TextBlock Text="{Binding PackText}" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding PackText}" />
              </Border>
              <Border Classes="badge plain" IsVisible="{Binding HasFolder}">
                <TextBlock Text="{Binding FolderText}" TextTrimming="CharacterEllipsis" />
              </Border>
            </StackPanel>

            <TextBlock Classes="meta" Text="{Binding HeroStateText}" />

            <StackPanel Spacing="4" IsVisible="{Binding Shell.IsActivityVisible}" MaxWidth="460"
                        HorizontalAlignment="Left">
              <TextBlock Classes="faint" Text="{Binding Shell.ActivityText}"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              <ProgressBar Value="{Binding Shell.ActivityFraction}"
                           IsIndeterminate="{Binding Shell.IsActivityIndeterminate}"
                           Classes="thin" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                      VerticalAlignment="Center">
            <Button Classes="primary" MinHeight="46" Padding="30,10" FontSize="15"
                    IsVisible="{Binding IsIdle}"
                    AutomationProperties.Name="{DynamicResource L.Library.Play}"
                    Command="{Binding PlayCommand}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <controls:IconGlyph Data="{StaticResource Icon.Play}" Width="17" Height="17"
                                    IsFilled="True" />
                <TextBlock Text="{DynamicResource L.Library.Play}" />
              </StackPanel>
            </Button>

            <Button MinHeight="46" Padding="24,10" FontSize="15"
                    IsVisible="{Binding IsRunning}"
                    AutomationProperties.Name="{DynamicResource L.Library.Stop}"
                    Command="{Binding StopCommand}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <controls:IconGlyph Data="{StaticResource Icon.Stop}" Width="15" Height="15"
                                    IsFilled="True" />
                <TextBlock Text="{DynamicResource L.Library.Stop}" />
              </StackPanel>
            </Button>

            <Button Classes="ghost icon-button lg"
                    AutomationProperties.Name="{DynamicResource L.Instance.Actions}"
                    ToolTip.Tip="{DynamicResource L.Instance.Actions}">
              <controls:IconGlyph Data="{StaticResource Icon.More}" Width="18" Height="18" />
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="{DynamicResource L.Common.OpenFolder}" Command="{Binding OpenFolderCommand}" />
                  <MenuItem Header="{DynamicResource L.Instance.Verify}" Command="{Binding VerifyCommand}" />
                  <MenuItem Header="{DynamicResource L.Common.Repair}" Command="{Binding RepairCommand}" />
                  <MenuItem Header="{DynamicResource L.Common.Save}" Command="{Binding SaveCommand}" />
                  <MenuItem Header="{DynamicResource L.Instance.ExportPack}" Click="OnExportModpackClick" />
                  <MenuItem Header="{DynamicResource L.Instance.UpdateFromPack}" Click="OnUpdateFromPackClick" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>
      </Panel>
    </Border>

    <TabControl Grid.Row="1" Classes="subnav" Margin="0,20,0,0">

      <TabItem Header="{DynamicResource L.Instance.TabSettings}" Icon="{StaticResource Icon.Settings}">
        <ScrollViewer>
          <StackPanel Spacing="16" Margin="0,16,0,0" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="{DynamicResource L.Instance.Loader}" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding LoaderSummary}" VerticalAlignment="Center" />
                <Button Content="{DynamicResource L.Instance.InstallOptiFine}"
                        Click="OnInstallOptiFineClick" />
                <Button Content="{DynamicResource L.Instance.InstallLabyMod}"
                        Command="{Binding InstallLabyModCommand}"
                        IsEnabled="{Binding !IsInstallingLoader}" />
              </StackPanel>
              <TextBlock Classes="faint" TextWrapping="Wrap"
                         Text="{DynamicResource L.Instance.OptiFineHint}" />
              <TextBlock Classes="faint" TextWrapping="Wrap"
                         Text="{DynamicResource L.Instance.LabyModHint}" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding LoaderStatus}" />
            </StackPanel>

            <StackPanel Spacing="4" IsVisible="{Binding CanChangeLoader}">
              <TextBlock Classes="label" Text="{DynamicResource L.Instance.LoaderVersion}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding LoaderVersions}"
                          SelectedItem="{Binding SelectedLoaderVersion}"
                          AutomationProperties.Name="{DynamicResource L.Instance.LoaderVersion}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding Version}" />
                        <TextBlock Classes="faint" Text="{DynamicResource L.Instance.LoaderStable}"
                                   IsVisible="{Binding Stable}" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" Content="{DynamicResource L.Instance.ApplyLoaderVersion}"
                        Command="{Binding ApplyLoaderVersionCommand}"
                        IsEnabled="{Binding !IsLoaderSwitchBusy}" />
              </Grid>
              <TextBlock Classes="faint" TextWrapping="Wrap" Text="{Binding LoaderSwitchStatus}" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="{DynamicResource L.Instance.FieldJavaRuntime}" />
              <ComboBox ItemsSource="{Binding JavaRuntimes}" SelectedItem="{Binding SelectedJava}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding DisplayName}" />
                      <TextBlock Classes="faint" Text="{Binding Source}" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
              <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Classes="label" Text="{DynamicResource L.Instance.FieldMaxMemory}" />
                <NumericUpDown Value="{Binding MemoryMb}" Minimum="0" Maximum="65536" Increment="512"
                               AutomationProperties.Name="{DynamicResource L.Instance.FieldMaxMemory}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Classes="label" Text="{DynamicResource L.Instance.FieldMinMemory}" />
                <NumericUpDown Value="{Binding MinMemoryMb}" Minimum="0" Maximum="65536" Increment="512"
                               AutomationProperties.Name="{DynamicResource L.Instance.FieldMinMemory}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Classes="label" Text="{DynamicResource L.Instance.FieldWindowSize}" />
                <Grid ColumnDefinitions="*,12,*" ColumnSpacing="0">
                  <NumericUpDown Grid.Column="0" Value="{Binding WindowWidth}" Minimum="0" Maximum="16384"
                                 AutomationProperties.Name="{DynamicResource L.Instance.FieldWindowWidth}"
                                 Increment="10" />
                  <NumericUpDown Grid.Column="2" Value="{Binding WindowHeight}" Minimum="0" Maximum="16384"
                                 AutomationProperties.Name="{DynamicResource L.Instance.FieldWindowHeight}"
                                 Increment="10" />
                </Grid>
                <TextBlock Classes="faint" Text="{DynamicResource L.Instance.WindowSizeHint}" />
              </StackPanel>
            </Grid>

            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="{DynamicResource L.Instance.FieldDefaultServer}" />
              <TextBox Text="{Binding ServerAddress}" PlaceholderText="{DynamicResource L.Instance.ServerAddressPlaceholder}" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="{DynamicResource L.Instance.FieldGroup}" />
              <TextBox Text="{Binding Group}"
                       AutomationProperties.Name="{DynamicResource L.Instance.FieldGroup}" />
              <TextBlock Classes="faint" TextWrapping="Wrap"
                         Text="{DynamicResource L.Instance.FieldGroupHint}" />
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="{DynamicResource L.Instance.FieldThemeAccent}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0" Text="{Binding ThemeAccent}" PlaceholderText="#D08A3E"
                         AutomationProperties.Name="{DynamicResource L.Instance.FieldThemeAccent}" />
                <Button Grid.Column="1" Content="{DynamicResource L.Instance.ChooseThemeBackground}"
                        Click="OnPickThemeBackgroundClick" />
              </Grid>
              <TextBlock Classes="faint" TextWrapping="Wrap" Text="{Binding ThemeError}"
                         Foreground="{DynamicResource FerriteDanger}"
                         IsVisible="{Binding HasThemeError}" />
              <TextBlock Classes="faint" TextWrapping="Wrap"
                         Text="{DynamicResource L.Instance.ThemeHint}" />
              <Button Classes="chip" HorizontalAlignment="Left"
                      Content="{DynamicResource L.Instance.ClearThemeBackground}"
                      Command="{Binding ClearThemeBackgroundCommand}"
                      IsVisible="{Binding HasThemeBackground}" />
            </StackPanel>

            <CheckBox Content="{DynamicResource L.Instance.DemoMode}" IsChecked="{Binding DemoMode}" />

            <StackPanel Spacing="4">
              <CheckBox Content="{DynamicResource L.Instance.AcceptEula}" IsChecked="{Binding AcceptEula}" />
              <TextBlock Classes="faint" TextWrapping="Wrap"
                         Text="{DynamicResource L.Instance.AcceptEulaHint}" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="{DynamicResource L.Instance.FieldJvmArguments}" />
              <TextBox Text="{Binding JvmArgumentsText}" AcceptsReturn="True" Height="88" Classes="mono"
                       AutomationProperties.Name="{DynamicResource L.Instance.FieldJvmArguments}" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="{DynamicResource L.Instance.FieldGameArguments}" />
              <TextBox Text="{Binding GameArgumentsText}" AcceptsReturn="True" Height="72" Classes="mono"
                       AutomationProperties.Name="{DynamicResource L.Instance.FieldGameArguments}" />
            </StackPanel>

            <TextBlock Classes="muted" Text="{Binding StatusNote}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{DynamicResource L.Instance.TabMods}" Icon="{StaticResource Icon.Mods}">
        <!--
          A dense list, not a wall of cards: a large pack is hundreds of rows, so the row carries the
          facts in columns and the actions live behind a menu and a selection bar.
        -->
        <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="0,16,0,0">

          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,10">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
              <TextBox Width="260" Text="{Binding ModQuery}"
                       PlaceholderText="{DynamicResource L.Instance.ModSearchPlaceholder}"
                       AutomationProperties.Name="{DynamicResource L.Instance.ModSearchPlaceholder}" />
              <ComboBox Width="150" ItemsSource="{Binding ModLoaderChoices}"
                        SelectedItem="{Binding SelectedModLoader}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{DynamicResource L.Instance.ColumnLoader}">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="vm:ChoiceOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox Width="160" ItemsSource="{Binding ModSortChoices}"
                        SelectedItem="{Binding SelectedModSort}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{DynamicResource L.Instance.SortName}">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="vm:ChoiceOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox Width="160" ItemsSource="{Binding ModGroupChoices}"
                        SelectedItem="{Binding SelectedModGroup}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{DynamicResource L.Instance.FieldModGroup}">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="vm:ChoiceOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Content="{DynamicResource L.Instance.ModGroups}"
                      Command="{Binding OpenModGroupsCommand}" />
              <Button Classes="primary" Content="{DynamicResource L.Instance.AddMods}"
                      Click="OnAddModsClick" />
            </StackPanel>
          </Grid>

          <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,10">
            <TextBlock Classes="faint" Text="{Binding ModFilterNote}"
                       IsVisible="{Binding HasModFilterNote}" />

            <!-- Bulk actions appear only when something is selected. -->
            <Border Classes="panel" Padding="12,8" IsVisible="{Binding HasModSelection}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Text="{Binding SelectedModSummary}"
                           VerticalAlignment="Center" IsVisible="{Binding HasSelectedModSummary}" />
                <TextBlock Grid.Column="1" Classes="faint" VerticalAlignment="Center"
                           Text="{DynamicResource L.Instance.DropModsHint}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                  <Button Content="{DynamicResource L.Instance.DisableSelected}"
                          Command="{Binding DisableSelectedModsCommand}" />
                  <Button Content="{DynamicResource L.Instance.EnableSelected}"
                          Command="{Binding EnableSelectedModsCommand}" />
                  <Button Classes="danger" Content="{DynamicResource L.Instance.RemoveSelected}"
                          Command="{Binding RemoveSelectedModsCommand}" />
                  <Button Classes="ghost" Content="{DynamicResource L.Instance.ClearModSelection}"
                          Command="{Binding ClearModSelectionCommand}" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>

          <!-- Column headings -->
          <Grid Grid.Row="2" ColumnDefinitions="36,*,150,110,90,110,116" ColumnSpacing="12"
                Margin="10,0,10,6">
            <TextBlock Grid.Column="1" Classes="label" Text="{DynamicResource L.Library.FieldName}" />
            <TextBlock Grid.Column="2" Classes="label" Text="{DynamicResource L.Instance.ColumnVersion}" />
            <TextBlock Grid.Column="3" Classes="label" Text="{DynamicResource L.Instance.ColumnLoader}" />
            <TextBlock Grid.Column="4" Classes="label" Text="{DynamicResource L.Instance.ColumnSize}" />
            <TextBlock Grid.Column="5" Classes="label" Text="{DynamicResource L.Instance.ColumnState}" />
            <Button Grid.Column="6" Classes="ghost" Padding="8,2" MinHeight="22" FontSize="12"
                    Content="{DynamicResource L.Instance.SelectAllMods}"
                    Command="{Binding SelectAllModsCommand}"
                    IsEnabled="{Binding HasAnyMods}" />
          </Grid>

          <ListBox Grid.Row="3" Classes="dense" ItemsSource="{Binding Mods}"
                   Background="Transparent" BorderThickness="0" Padding="0">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:ModItemViewModel">
                <Grid ColumnDefinitions="36,*,150,110,90,110,116" ColumnSpacing="12">
                  <CheckBox Grid.Column="0" VerticalAlignment="Center"
                            IsChecked="{Binding IsSelected}"
                            AutomationProperties.Name="{Binding DisplayName}" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{Binding DisplayName}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}" />
                    <TextBlock Classes="faint" Text="{Binding DependencyText}"
                               IsVisible="{Binding HasDependencies}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="danger" Text="{Binding Note}" IsVisible="{Binding HasNote}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Classes="meta" Text="{Binding VersionText}"
                             VerticalAlignment="Center" TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding VersionText}" />
                  <TextBlock Grid.Column="3" Classes="meta" Text="{Binding Loader}"
                             VerticalAlignment="Center" TextWrapping="NoWrap" />
                  <TextBlock Grid.Column="4" Classes="meta" Text="{Binding SizeText}"
                             VerticalAlignment="Center" TextWrapping="NoWrap" />
                  <Border Grid.Column="5" Classes="badge" HorizontalAlignment="Left"
                          Classes.success="{Binding IsEnabled}">
                    <TextBlock Text="{Binding StateText}" />
                  </Border>
                  <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6"
                              HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Classes="chip" Content="{DynamicResource L.Instance.Disable}"
                            IsVisible="{Binding IsEnabled}" Command="{Binding ToggleCommand}" />
                    <Button Classes="chip" Content="{DynamicResource L.Instance.Enable}"
                            IsVisible="{Binding !IsEnabled}" Command="{Binding ToggleCommand}" />
                    <Button Classes="ghost icon-button sm"
                            AutomationProperties.Name="{DynamicResource L.Instance.Actions}"
                            ToolTip.Tip="{DynamicResource L.Instance.Actions}">
                      <controls:IconGlyph Data="{StaticResource Icon.More}" Width="14" Height="14" />
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Header="{DynamicResource L.Common.OpenFolder}"
                                    Command="{Binding OpenFolderCommand}" />
                          <MenuItem Header="{DynamicResource L.Common.Remove}"
                                    Foreground="{DynamicResource FerriteDanger}"
                                    Command="{Binding RemoveCommand}" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Spacing="10" MaxWidth="420" IsVisible="{Binding !HasAnyMods}">
            <controls:IconGlyph Data="{StaticResource Icon.Mods}" Width="28" Height="28"
                                Opacity="0.5" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" TextAlignment="Center"
                       Text="{DynamicResource L.Instance.NoMods}" />
            <TextBlock Classes="faint" TextAlignment="Center"
                       Text="{DynamicResource L.Instance.DropModsHint}" />
          </StackPanel>

          <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Spacing="10" MaxWidth="420" IsVisible="{Binding HasNoModMatches}">
            <controls:IconGlyph Data="{StaticResource Icon.Search}" Width="28" Height="28"
                                Opacity="0.5" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" TextAlignment="Center"
                       Text="{DynamicResource L.Instance.NoModMatches}" />
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="{DynamicResource L.Instance.TabContent}" Icon="{StaticResource Icon.Content}">
        <Grid RowDefinitions="Auto,Auto,*" Margin="0,16,0,0">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <Button Classes="primary" Content="{DynamicResource L.Instance.CheckContentUpdates}" Command="{Binding CheckUpdatesCommand}" />
            <Button Content="{DynamicResource L.Instance.UpdateSelected}" Command="{Binding ApplyUpdatesCommand}" />
          </StackPanel>

          <TextBlock Grid.Row="1" Classes="faint" Margin="0,0,0,10" TextWrapping="Wrap"
                     Text="{Binding UpdateStatus}" />

          <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="8">
              <ItemsControl ItemsSource="{Binding Updates}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:ContentUpdateItemViewModel">
                    <Border Classes="panel" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                  AutomationProperties.Name="{DynamicResource L.Common.SelectItem}" />
                        <StackPanel Grid.Column="1" Spacing="3">
                          <TextBlock Text="{Binding Name}" TextWrapping="NoWrap"
                                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                          <TextBlock Classes="mono" Text="{Binding Detail}" TextWrapping="NoWrap"
                                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
                          <TextBlock Classes="faint" Text="{Binding ProviderNote}" />
                          <TextBlock Classes="muted" Text="{Binding Note}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Center"
                      Spacing="10" MaxWidth="460" IsVisible="{Binding !HasUpdates}">
            <controls:IconGlyph Data="{StaticResource Icon.Content}" Width="28" Height="28"
                                Opacity="0.5" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" TextAlignment="Center"
                       Text="{DynamicResource L.Instance.NoContentUpdates}" />
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="{DynamicResource L.Instance.TabWorlds}" Icon="{StaticResource Icon.World}">
        <Grid RowDefinitions="Auto,*" Margin="0,16,0,0">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,12">
            <Button Grid.Column="0" Content="{DynamicResource L.Common.Refresh}" Command="{Binding RefreshGameDataCommand}" />
            <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center"
                     Text="{DynamicResource L.Instance.WorldsHint}" />
            <Button Grid.Column="2" Content="{DynamicResource L.Instance.OpenSaves}" Click="OnOpenSavesClick" />
          </Grid>

          <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Worlds}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:WorldItemViewModel">
                  <Border Classes="card" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                      <Image Grid.Column="0" Source="{Binding IconBitmap}" Width="48" Height="48"
                             Stretch="UniformToFill" VerticalAlignment="Top"
                             IsVisible="{Binding HasIconBitmap}" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Classes="h2" Text="{Binding Name}" />
                        <TextBlock Classes="muted" Text="{Binding DetailText}" />
                        <TextBlock Classes="faint" Text="{Binding SeedText}" />
                        <TextBlock Classes="faint" Text="{Binding Note}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="primary" Content="{DynamicResource L.Instance.PlayWorld}" Command="{Binding PlayCommand}" />
                <Button Content="{DynamicResource L.Instance.Backup}" Command="{Binding BackupCommand}" />
                <Button Content="{DynamicResource L.Instance.Duplicate}" Command="{Binding DuplicateCommand}" />
                <Button Content="{DynamicResource L.Common.Folder}" Command="{Binding OpenFolderCommand}" />
                <Button Classes="danger" Content="{DynamicResource L.Common.Delete}" Command="{Binding DeleteCommand}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <TextBlock Grid.Row="1" Classes="muted" IsVisible="{Binding !HasWorlds}"
                     Text="{DynamicResource L.Instance.NoWorlds}" />
        </Grid>
      </TabItem>

      <TabItem Header="{DynamicResource L.Instance.TabServers}" Icon="{StaticResource Icon.Server}">
        <Grid RowDefinitions="Auto,*" Margin="0,16,0,0">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" Margin="0,0,0,12">
            <TextBox Grid.Column="0" PlaceholderText="{DynamicResource L.Instance.ServerAddressPlaceholder}" Text="{Binding NewServerAddress}" />
            <TextBox Grid.Column="1" Width="160" PlaceholderText="{DynamicResource L.Instance.ServerNamePlaceholder}" Text="{Binding NewServerName}" />
            <Button Grid.Column="2" Content="{DynamicResource L.Common.Add}" Command="{Binding AddServerCommand}" />
            <Button Grid.Column="3" Classes="primary" Content="{DynamicResource L.Instance.PingAll}" Command="{Binding PingServersCommand}" />
          </Grid>

          <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="18">
              <StackPanel Spacing="6">
                <TextBlock Classes="label" Text="{DynamicResource L.Instance.SavedServers}" />
                <ItemsControl ItemsSource="{Binding Servers}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ServerItemViewModel">
                      <Border Classes="card" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                          <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Classes="h2" Text="{Binding Name}" />
                            <TextBlock Classes="mono" Text="{Binding Address}" />
                            <TextBlock Classes="muted" Text="{Binding StatusText}" />
                            <TextBlock Classes="faint" Text="{Binding Motd}" IsVisible="{Binding HasMotd}" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="danger" Content="{DynamicResource L.Common.Remove}"
                                  Command="{Binding RemoveCommand}" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="faint" IsVisible="{Binding !HasServers}"
                           Text="{DynamicResource L.Instance.NoServers}" />
              </StackPanel>

              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Button Grid.Column="0" Content="{DynamicResource L.Instance.FindLanWorlds}"
                          Command="{Binding ToggleLanScanCommand}" />
                  <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center"
                             TextWrapping="Wrap" Text="{Binding LanStatus}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding LanWorlds}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:LanWorldItemViewModel">
                      <Border Classes="card" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                          <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Classes="h2" Text="{Binding Name}" />
                            <TextBlock Classes="mono" Text="{Binding Address}" />
                            <TextBlock Classes="faint" Text="{Binding LastSeenText}" />
                            <TextBlock Classes="muted" Text="{Binding Note}" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="primary" Content="{DynamicResource L.Common.Add}"
                                  Command="{Binding AddToServersCommand}" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="{DynamicResource L.Instance.TabFiles}" Icon="{StaticResource Icon.Layers}">
        <ScrollViewer>
          <StackPanel Spacing="18" Margin="0,16,0,0">
            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="{DynamicResource L.Instance.ResourcePacks}" />
              <ItemsControl ItemsSource="{Binding ResourcePacks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:InstanceContentItemViewModel">
                    <Border Classes="card" Margin="0,0,0,8">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Grid.Column="0" Spacing="2">
                          <TextBlock Text="{Binding FileName}" />
                          <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Classes="faint" Text="{Binding PackFormatText}" IsVisible="{Binding HasPackFormat}" />
                            <TextBlock Classes="faint" Text="{Binding SizeText}" />
                          </StackPanel>
                          <TextBlock Classes="faint" TextWrapping="Wrap"
                                     Text="{Binding CompatibilityText}" IsVisible="{Binding HasCompatibility}" />
                          <TextBlock Classes="faint" Text="{Binding Note}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Button Classes="chip" Content="{DynamicResource L.Instance.Disable}"
                                  IsVisible="{Binding IsEnabled}" Command="{Binding ToggleCommand}" />
                          <Button Classes="chip" Content="{DynamicResource L.Instance.Enable}"
                                  IsVisible="{Binding !IsEnabled}" Command="{Binding ToggleCommand}" />
                          <Button Classes="ghost icon-button sm"
                                  AutomationProperties.Name="{DynamicResource L.Instance.Actions}"
                                  ToolTip.Tip="{DynamicResource L.Instance.Actions}">
                            <controls:IconGlyph Data="{StaticResource Icon.More}" Width="14" Height="14" />
                            <Button.Flyout>
                              <MenuFlyout>
                                <MenuItem Header="{DynamicResource L.Common.OpenFolder}"
                                          Command="{Binding OpenFolderCommand}" />
                                <MenuItem Header="{DynamicResource L.Common.Remove}"
                                          Foreground="{DynamicResource FerriteDanger}"
                                          Command="{Binding RemoveCommand}" />
                              </MenuFlyout>
                            </Button.Flyout>
                          </Button>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !HasResourcePacks}">
                <controls:IconGlyph Data="{StaticResource Icon.Layers}" Width="14" Height="14" Opacity="0.6" />
                <TextBlock Classes="faint" Text="{DynamicResource L.Instance.NoResourcePacks}" />
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="{DynamicResource L.Instance.ShaderPacks}" />
              <ItemsControl ItemsSource="{Binding ShaderPacks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:InstanceContentItemViewModel">
                    <Border Classes="card" Margin="0,0,0,8">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Grid.Column="0" Spacing="2">
                          <TextBlock Text="{Binding FileName}" />
                          <TextBlock Classes="faint" Text="{Binding SizeText}" />
                          <TextBlock Classes="faint" Text="{Binding Note}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Button Classes="chip" Content="{DynamicResource L.Instance.Disable}"
                                  IsVisible="{Binding IsEnabled}" Command="{Binding ToggleCommand}" />
                          <Button Classes="chip" Content="{DynamicResource L.Instance.Enable}"
                                  IsVisible="{Binding !IsEnabled}" Command="{Binding ToggleCommand}" />
                          <Button Classes="ghost icon-button sm"
                                  AutomationProperties.Name="{DynamicResource L.Instance.Actions}"
                                  ToolTip.Tip="{DynamicResource L.Instance.Actions}">
                            <controls:IconGlyph Data="{StaticResource Icon.More}" Width="14" Height="14" />
                            <Button.Flyout>
                              <MenuFlyout>
                                <MenuItem Header="{DynamicResource L.Common.OpenFolder}"
                                          Command="{Binding OpenFolderCommand}" />
                                <MenuItem Header="{DynamicResource L.Common.Remove}"
                                          Foreground="{DynamicResource FerriteDanger}"
                                          Command="{Binding RemoveCommand}" />
                              </MenuFlyout>
                            </Button.Flyout>
                          </Button>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !HasShaderPacks}">
                <controls:IconGlyph Data="{StaticResource Icon.Layers}" Width="14" Height="14" Opacity="0.6" />
                <TextBlock Classes="faint" Text="{DynamicResource L.Instance.NoShaderPacks}" />
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="{DynamicResource L.Instance.Datapacks}" />
              <ItemsControl ItemsSource="{Binding WorldDatapacks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:WorldDatapacksViewModel">
                    <StackPanel Spacing="4" Margin="0,0,0,12">
                      <TextBlock Classes="muted" Text="{Binding WorldName}" />
                      <ItemsControl ItemsSource="{Binding Datapacks}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:InstanceContentItemViewModel">
                            <Border Classes="card" Margin="0,0,0,8">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Grid.Column="0" Spacing="2">
                                  <TextBlock Text="{Binding FileName}" />
                                  <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Classes="faint" Text="{Binding PackFormatText}" IsVisible="{Binding HasPackFormat}" />
                                    <TextBlock Classes="faint" Text="{Binding SizeText}" />
                                  </StackPanel>
                                  <TextBlock Classes="faint" TextWrapping="Wrap"
                                             Text="{Binding CompatibilityText}" IsVisible="{Binding HasCompatibility}" />
                                  <TextBlock Classes="faint" Text="{Binding Note}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                  <Button Content="{DynamicResource L.Instance.Disable}" IsVisible="{Binding IsEnabled}"
                                          Command="{Binding ToggleCommand}" />
                                  <Button Content="{DynamicResource L.Instance.Enable}" IsVisible="{Binding !IsEnabled}"
                                          Command="{Binding ToggleCommand}" />
                                  <Button Content="{DynamicResource L.Common.OpenFolder}" Command="{Binding OpenFolderCommand}" />
                                  <Button Classes="danger" Content="{DynamicResource L.Common.Remove}" Command="{Binding RemoveCommand}" />
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Classes="faint" Text="{DynamicResource L.Instance.NoDatapacks}"
                                 IsVisible="{Binding !HasDatapacks}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="faint" Text="{DynamicResource L.Instance.NoWorldsForDatapacks}"
                         IsVisible="{Binding !HasWorldDatapacks}" />
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="{DynamicResource L.Instance.Screenshots}" />
              <ItemsControl ItemsSource="{Binding Screenshots}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:ScreenshotItemViewModel">
                    <Border Classes="card" Width="220" Margin="0,0,10,10">
                      <StackPanel Spacing="4">
                        <Image Source="{Binding Thumbnail}" Height="120" Stretch="Uniform"
                               IsVisible="{Binding HasThumbnail}" />
                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="faint" Text="{Binding DetailText}" />
                        <TextBlock Classes="faint" Text="{Binding Note}" />
                        <Button Content="{DynamicResource L.Common.OpenFile}" HorizontalAlignment="Left"
                                Command="{Binding OpenFolderCommand}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !HasScreenshots}">
                <controls:IconGlyph Data="{StaticResource Icon.Image}" Width="14" Height="14" Opacity="0.6" />
                <TextBlock Classes="faint" Text="{DynamicResource L.Instance.NoScreenshots}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{DynamicResource L.Instance.TabLogs}" Icon="{StaticResource Icon.Terminal}">
        <Grid RowDefinitions="Auto,*,240" Margin="0,16,0,0" RowSpacing="12">

          <!-- Log toolbar -->
          <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
            <ComboBox Grid.Column="0" Width="150" ItemsSource="{Binding LogSeverities}"
                      SelectedItem="{Binding SelectedLogSeverity}"
                      AutomationProperties.Name="{DynamicResource L.Instance.LogAll}">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="vm:ChoiceOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Grid.Column="1" Width="260"
                     PlaceholderText="{DynamicResource L.Instance.LogSearchPlaceholder}"
                     Text="{Binding LogQuery}" />
            <TextBlock Grid.Column="2" Classes="faint" VerticalAlignment="Center"
                       Text="{Binding LogSummaryText}" />
            <CheckBox Grid.Column="3" VerticalAlignment="Center"
                      Content="{DynamicResource L.Instance.LogFollow}"
                      IsChecked="{Binding FollowTail}" />
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
              <Button Classes="ghost" Content="{DynamicResource L.Instance.LogOpenFolder}"
                      Click="OnOpenLogsClick" />
              <Button Classes="ghost" Content="{DynamicResource L.Instance.LogCopy}"
                      Click="OnCopyLogClick" />
              <Button Classes="ghost icon-button"
                      AutomationProperties.Name="{DynamicResource L.Common.Refresh}"
                      ToolTip.Tip="{DynamicResource L.Common.Refresh}"
                      Command="{Binding RefreshLogCommand}">
                <controls:IconGlyph Data="{StaticResource Icon.Refresh}" />
              </Button>
            </StackPanel>
          </Grid>

          <!-- Log body -->
          <Border Grid.Row="1" Classes="panel" Padding="0">
            <ListBox Name="LogList" Classes="log" ItemsSource="{Binding VisibleLogLines}"
                     Background="Transparent" BorderThickness="0" Padding="6">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:LogLineViewModel">
                  <TextBlock Classes="mono" Text="{Binding Text}"
                             Classes.warning="{Binding IsWarning}"
                             Classes.danger="{Binding IsError}"
                             TextWrapping="NoWrap" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Spacing="8" MaxWidth="420" IsVisible="{Binding ShowsEmptyLog}">
            <controls:IconGlyph Data="{StaticResource Icon.Terminal}" Width="26" Height="26"
                                Opacity="0.5" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" TextAlignment="Center"
                       Text="{DynamicResource L.Instance.NoLogs}" />
            <TextBlock Classes="faint" TextAlignment="Center"
                       Text="{DynamicResource L.Instance.LogOpenFolder}" />
          </StackPanel>

          <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Spacing="8" MaxWidth="420" IsVisible="{Binding ShowsNoLogMatches}">
            <controls:IconGlyph Data="{StaticResource Icon.Search}" Width="26" Height="26"
                                Opacity="0.5" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" TextAlignment="Center"
                       Text="{DynamicResource L.Instance.NoLogMatches}" />
          </StackPanel>

          <!-- Crash reports -->
          <Grid Grid.Row="2" ColumnDefinitions="260,*" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="6">
              <TextBlock Classes="label" Text="{DynamicResource L.Instance.CrashReports}" />
              <ListBox Classes="dense" ItemsSource="{Binding CrashReports}"
                       SelectedItem="{Binding SelectedCrashReport}"
                       Background="Transparent" BorderThickness="0" Padding="0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                 TextWrapping="NoWrap" ToolTip.Tip="{Binding FileName}" />
                      <TextBlock Classes="faint" Text="{Binding Summary}" MaxLines="1"
                                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Classes="faint" Text="{DynamicResource L.Instance.NoCrashReports}"
                         IsVisible="{Binding !HasCrashReports}" />
            </StackPanel>

            <Border Grid.Column="1" Classes="panel" Padding="12">
              <ScrollViewer>
                <SelectableTextBlock Classes="mono" TextWrapping="Wrap"
                                     Text="{Binding CrashAnalysisSummary}" />
              </ScrollViewer>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="{DynamicResource L.Instance.TabStructure}" Icon="{StaticResource Icon.Blueprint}">
        <Grid RowDefinitions="Auto,Auto,*" Margin="0,16,0,0" RowSpacing="12">
          <WrapPanel Grid.Row="0" Orientation="Horizontal">
            <StackPanel Spacing="4" Margin="0,0,16,8" IsVisible="{Binding HasStructureFiles}">
              <TextBlock Classes="label" Text="{DynamicResource L.Instance.StructureInWorlds}" />
              <ComboBox ItemsSource="{Binding StructureFiles}" SelectedItem="{Binding SelectedStructureFile}"
                        Width="360">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="vm:StructureFileItem">
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Path}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Margin="0,0,0,8">
              <Button Content="{DynamicResource L.Instance.StructureLoad}"
                      Command="{Binding LoadSelectedStructureCommand}"
                      IsEnabled="{Binding HasStructureFiles}" />
              <Button Classes="primary" Content="{DynamicResource L.Instance.StructureChoose}"
                      Click="OnPickStructureFileClick" />
            </StackPanel>
          </WrapPanel>

          <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding StructureSummary}"
                       IsVisible="{Binding HasStructureSummary}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding StructureCompatibilityText}" />
            <TextBlock Classes="faint" TextWrapping="Wrap" Text="{Binding StructureStatus}"
                       IsVisible="{Binding HasStructureStatus}" />
          </StackPanel>

          <Grid Grid.Row="2" ColumnDefinitions="*,260" ColumnSpacing="12">
            <Border Grid.Column="0" Classes="card" Padding="8">
              <Image Source="{Binding StructureImage}" Stretch="Uniform"
                     RenderOptions.BitmapInterpolationMode="None"
                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                     AutomationProperties.Name="{DynamicResource L.Instance.StructureChoose}"
                     IsVisible="{Binding HasStructureImage}" />
            </Border>
            <Border Grid.Column="1" Classes="card">
              <StackPanel Spacing="6">
                <TextBlock Classes="label" Text="{DynamicResource L.Instance.StructureMaterials}" />
                <SelectableTextBlock Classes="mono" Text="{Binding StructureMaterials}"
                                     IsVisible="{Binding HasStructureMaterials}" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="{DynamicResource L.Instance.TabMap}" Icon="{StaticResource Icon.Map}">
        <Grid RowDefinitions="Auto,Auto,*" Margin="0,16,0,0" RowSpacing="12">
          <WrapPanel Grid.Row="0" Orientation="Horizontal">
            <StackPanel Spacing="4" Margin="0,0,16,8">
              <TextBlock Classes="label" Text="{DynamicResource L.Instance.MapWorld}" />
              <ComboBox ItemsSource="{Binding Worlds}" SelectedItem="{Binding MapWorld}" Width="220">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="vm:WorldItemViewModel">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Spacing="4" Margin="0,0,16,8">
              <TextBlock Classes="label" Text="{DynamicResource L.Instance.MapCopyTo}" />
              <ComboBox ItemsSource="{Binding Worlds}" SelectedItem="{Binding MapCopyTarget}" Width="220">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="vm:WorldItemViewModel">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Margin="0,0,0,8">
              <Button Classes="primary" Content="{DynamicResource L.Instance.MapRefresh}"
                      Command="{Binding RefreshMapCommand}" IsEnabled="{Binding !IsMapping}" />
              <Button Content="{DynamicResource L.Instance.MapClearSelection}"
                      Command="{Binding ClearChunkSelectionCommand}"
                      IsEnabled="{Binding HasChunkSelection}" />
              <Button Classes="danger" Content="{DynamicResource L.Instance.MapDelete}"
                      Command="{Binding DeleteSelectedChunksCommand}"
                      IsEnabled="{Binding HasChunkSelection}" />
              <Button Content="{DynamicResource L.Instance.MapCopy}"
                      Command="{Binding CopySelectedChunksCommand}"
                      IsEnabled="{Binding HasChunkSelection}" />
            </StackPanel>
          </WrapPanel>

          <StackPanel Grid.Row="1" Spacing="2">
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding MapStatus}"
                       IsVisible="{Binding HasMapStatus}" />
            <TextBlock Classes="faint" Text="{Binding MapSelectionText}"
                       IsVisible="{Binding HasChunkSelection}" />
          </StackPanel>

          <Border Grid.Row="2" Classes="card" Padding="8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <Image Name="WorldMapImage" Source="{Binding WorldMapImage}" Stretch="None"
                     PointerPressed="OnWorldMapPointerPressed"
                     AutomationProperties.Name="{DynamicResource L.Instance.MapRefresh}"
                     IsVisible="{Binding HasWorldMap}" />
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="{DynamicResource L.Instance.TabLocalServer}" Icon="{StaticResource Icon.Cube}">
        <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="0,16,0,0" RowSpacing="12">
          <TextBlock Grid.Row="0" Classes="muted" TextWrapping="Wrap"
                     Text="{DynamicResource L.Instance.ServerHint}" />

          <WrapPanel Grid.Row="1" Orientation="Horizontal">
            <StackPanel Spacing="4" Margin="0,0,16,8">
              <TextBlock Classes="label" Text="{DynamicResource L.Instance.ServerLevelName}" />
              <TextBox Text="{Binding ServerLevelName}" Width="180"
                       AutomationProperties.Name="{DynamicResource L.Instance.ServerLevelName}" />
            </StackPanel>
            <StackPanel Spacing="4" Margin="0,0,16,8">
              <TextBlock Classes="label" Text="{DynamicResource L.Instance.ServerMotd}" />
              <TextBox Text="{Binding ServerMotd}" Width="240"
                       AutomationProperties.Name="{DynamicResource L.Instance.ServerMotd}" />
            </StackPanel>
            <StackPanel Spacing="4" Margin="0,0,16,8">
              <TextBlock Classes="label" Text="{DynamicResource L.Instance.ServerPort}" />
              <NumericUpDown Value="{Binding ServerPort}" Minimum="1" Maximum="65535" Width="120"
                             AutomationProperties.Name="{DynamicResource L.Instance.ServerPort}" />
            </StackPanel>
            <StackPanel Spacing="4" Margin="0,0,16,8">
              <TextBlock Classes="label" Text="{DynamicResource L.Instance.ServerMaxPlayers}" />
              <NumericUpDown Value="{Binding ServerMaxPlayers}" Minimum="1" Maximum="1000" Width="120"
                             AutomationProperties.Name="{DynamicResource L.Instance.ServerMaxPlayers}" />
            </StackPanel>
            <StackPanel Spacing="4" Margin="0,0,16,8">
              <TextBlock Classes="label" Text="{DynamicResource L.Instance.FieldMaxMemory}" />
              <NumericUpDown Value="{Binding ServerMemoryMb}" Minimum="512" Maximum="65536" Increment="512"
                             Width="140"
                             AutomationProperties.Name="{DynamicResource L.Instance.ServerMemory}" />
            </StackPanel>
            <StackPanel Spacing="8" VerticalAlignment="Bottom" Margin="0,0,16,8">
              <CheckBox Content="{DynamicResource L.Instance.ServerOnlineMode}"
                        IsChecked="{Binding ServerOnlineMode}" />
              <CheckBox Content="{DynamicResource L.Instance.ServerAcceptEula}"
                        IsChecked="{Binding ServerAcceptEula}" />
            </StackPanel>
          </WrapPanel>

          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="{DynamicResource L.Instance.ServerPrepare}"
                    Command="{Binding PrepareServerCommand}" IsEnabled="{Binding !IsServerBusy}" />
            <Button Content="{DynamicResource L.Instance.ServerStart}"
                    Command="{Binding StartServerCommand}" IsEnabled="{Binding CanStartServer}" />
            <Button Content="{DynamicResource L.Instance.ServerStop}"
                    Command="{Binding StopServerCommand}" IsEnabled="{Binding IsServerRunning}" />
            <Button Content="{DynamicResource L.Instance.ServerExport}" Click="OnExportServerClick" />
          </StackPanel>

          <TextBlock Grid.Row="3" Classes="muted" TextWrapping="Wrap" Text="{Binding ServerStatus}"
                     IsVisible="{Binding HasServerStatus}" />
        </Grid>
      </TabItem>

      <TabItem Header="{DynamicResource L.Instance.TabAssistant}" Icon="{StaticResource Icon.Assistant}">
        <Grid RowDefinitions="Auto,*" Margin="0,16,0,0" RowSpacing="12">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <Button Classes="primary" Content="{DynamicResource L.Instance.RunAssistant}"
                    Command="{Binding AskAssistantCommand}"
                    IsEnabled="{Binding !IsAdvising}" />
            <TextBlock Classes="muted" VerticalAlignment="Center"
                       Text="{DynamicResource L.Instance.AssistantHint}" />
          </StackPanel>
          <Border Grid.Row="1" Classes="card">
            <ScrollViewer>
              <SelectableTextBlock Classes="mono" TextWrapping="Wrap"
                                   Text="{Binding AdvisorText}"
                                   IsVisible="{Binding HasAdvisorText}" />
            </ScrollViewer>
          </Border>

          <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Spacing="10" MaxWidth="460" IsVisible="{Binding ShowsAssistantEmptyState}">
            <controls:IconGlyph Data="{StaticResource Icon.Assistant}" Width="28" Height="28"
                                Opacity="0.5" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" TextAlignment="Center"
                       Text="{DynamicResource L.Instance.AssistantEmpty}" />
          </StackPanel>

          <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Spacing="10" MaxWidth="460" IsVisible="{Binding IsAdvising}">
            <TextBlock Classes="muted" TextAlignment="Center"
                       Text="{DynamicResource L.Instance.AssistantRunning}" />
            <ProgressBar IsIndeterminate="True" Width="220" />
          </StackPanel>
        </Grid>
      </TabItem>

    </TabControl>

    <TextBlock Grid.Row="2" Classes="muted" Margin="0,12,0,0" Text="{Binding StatusNote}" />

    <!-- Mod group editor -->
    <Border Grid.Row="0" Grid.RowSpan="3"
            Background="{DynamicResource FerriteScrim}" IsVisible="{Binding IsManagingModGroups}">
      <Border Classes="overlay" Width="520" MaxHeight="640" Padding="20"
              VerticalAlignment="Center" HorizontalAlignment="Center">
        <ScrollViewer>
        <StackPanel Spacing="14">
          <TextBlock Classes="h2" Text="{DynamicResource L.Instance.ModGroups}" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="{DynamicResource L.Instance.ModGroupHint}" />

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="{DynamicResource L.Instance.ModGroupExisting}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <ComboBox Grid.Column="0" ItemsSource="{Binding ModGroupChoices}"
                        SelectedItem="{Binding SelectedManagedGroup}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="vm:ChoiceOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="1" Classes="danger" Content="{DynamicResource L.Common.Remove}"
                      Command="{Binding RemoveModGroupCommand}"
                      IsEnabled="{Binding CanRemoveManagedGroup}" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="{DynamicResource L.Instance.ModGroupName}" />
            <TextBox Text="{Binding NewModGroupName}"
                     AutomationProperties.Name="{DynamicResource L.Instance.ModGroupName}" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="{DynamicResource L.Instance.ModGroupMatch}" />
            <TextBox Text="{Binding NewModGroupMatch}"
                     AutomationProperties.Name="{DynamicResource L.Instance.ModGroupMatch}" />
          </StackPanel>

          <TextBlock Text="{Binding ModGroupError}" Foreground="{DynamicResource FerriteDanger}"
                     IsVisible="{Binding HasModGroupError}" />

          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{DynamicResource L.Common.Cancel}" Command="{Binding CloseModGroupsCommand}" />
            <Button Classes="primary" Content="{DynamicResource L.Common.Add}" Command="{Binding AddModGroupCommand}" />
          </StackPanel>
        </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>

  </Grid>

</UserControl>
