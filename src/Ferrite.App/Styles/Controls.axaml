<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource FerriteSurface}" />
    <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource FerriteText}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource FerriteTextMuted}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource FerriteTextMuted}" />
  </Style>

  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{DynamicResource FerriteTextFaint}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource FerriteSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FerriteBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource FerriteSurfaceRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource FerriteText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FerriteBorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource FerriteAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource FerriteAccentText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FerriteAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource FerriteDanger}" />
  </Style>

  <!--
    A low-emphasis inline action: the folder chip on an instance card, and similar metadata. It stays
    a real button so it is keyboard reachable and gets the focus treatment below, but it carries no
    fill and sits at text scale so a dense row does not look like a wall of buttons.
  -->
  <Style Selector="Button.chip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FerriteTextMuted}" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Button.chip:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource FerriteText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FerriteBorder}" />
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!--
    Keyboard focus has to be visible on every control the user can tab to. The border is drawn in the
    accent colour and thickened rather than animated, so it is unmistakable at a glance and does not
    move the layout.
  -->
  <Style Selector="Button:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource FerriteAccent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="TextBox:focus-visible, ComboBox:focus-visible, NumericUpDown:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource FerriteAccent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!--
    A field the user is typing into shows focus even when it was reached with the pointer, because the
    caret alone is not enough to tell where the next keystroke will land.
  -->
  <Style Selector="TextBox:focus, ComboBox:focus, NumericUpDown:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource FerriteAccent}" />
  </Style>

  <Style Selector="CheckBox:focus-visible">
    <Setter Property="Foreground" Value="{DynamicResource FerriteAccent}" />
  </Style>

  <Style Selector="TabItem:focus-visible">
    <Setter Property="Foreground" Value="{DynamicResource FerriteAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="ListBoxItem:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource FerriteAccent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="TextBox, ComboBox">
    <Setter Property="Background" Value="{DynamicResource FerriteSurfaceSunken}" />
    <Setter Property="Foreground" Value="{DynamicResource FerriteText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FerriteBorder}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Foreground" Value="{DynamicResource FerriteTextMuted}" />
  </Style>

  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource FerriteText}" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource FerriteAccent}" />
    <Setter Property="Background" Value="{DynamicResource FerriteSurfaceSunken}" />
  </Style>

  <!-- Navigation list: Ferrite uses its own accent for selection rather than the theme default. -->
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource FerriteTextMuted}" />
  </Style>

  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FerriteBorder}" />
  </Style>

  <Style Selector="ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource FerriteAccentText}" />
  </Style>

  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FerriteAccent}" />
  </Style>

</Styles>
