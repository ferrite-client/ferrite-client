<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Control templates.

    Ferrite draws its own button and tab chrome rather than fighting the Fluent theme's state
    brushes. Everything else is steered with property setters in Controls.axaml, which keeps the
    surface area small and the theme's own accessibility behaviour intact.
  -->

  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource FerriteSurfaceRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource FerriteText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FerriteBorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeightMd}" />
    <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.12" />
              <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
            </Transitions>
          </Border.Transitions>
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button:pointerover /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource FerriteHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FerriteBorderStrong}" />
  </Style>

  <Style Selector="Button:pressed /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource FerritePressed}" />
  </Style>

  <Style Selector="Button:disabled /template/ Border#PART_Root">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="Button:focus-visible /template/ Border#PART_Root">
    <Setter Property="BorderBrush" Value="{DynamicResource FerriteAccent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Filled (primary) button: accent surface, no separate hover tinting of the border. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource FerriteAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FerriteAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource FerriteAccentText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource FerriteAccentHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FerriteAccentHover}" />
  </Style>

  <Style Selector="Button.primary:pressed /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource FerriteAccentPressed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FerriteAccentPressed}" />
  </Style>

  <!-- Destructive button: only the label and hover wash carry the danger; no shouty red fill. -->
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource FerriteDanger}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FerriteBorderStrong}" />
  </Style>

  <Style Selector="Button.danger:pointerover /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource FerriteDangerSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FerriteDanger}" />
  </Style>

  <Style Selector="Button.danger-solid">
    <Setter Property="Background" Value="{DynamicResource FerriteDanger}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FerriteDanger}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Borderless button: reads as text until hovered, for dense rows and toolbars. -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FerriteTextMuted}" />
  </Style>

  <Style Selector="Button.ghost:pointerover /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource FerriteHover}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="Button.ghost:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource FerriteText}" />
  </Style>

  <!--
    Square icon-only button. Icons are the label, so the tooltip and the automation name carry the
    meaning for anyone who cannot see the glyph.
  -->
  <Style Selector="Button.icon-button">
    <Setter Property="Width" Value="{DynamicResource ControlHeightMd}" />
    <Setter Property="Height" Value="{DynamicResource ControlHeightMd}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.icon-button.lg">
    <Setter Property="Width" Value="{DynamicResource ControlHeightLg}" />
    <Setter Property="Height" Value="{DynamicResource ControlHeightLg}" />
  </Style>

  <Style Selector="Button.icon-button.sm">
    <Setter Property="Width" Value="{DynamicResource ControlHeightSm}" />
    <Setter Property="Height" Value="{DynamicResource ControlHeightSm}" />
  </Style>

  <!-- Compact action chip used on cards and in metadata rows. -->
  <Style Selector="Button.chip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FerriteTextMuted}" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="{DynamicResource FontMeta}" />
  </Style>

  <Style Selector="Button.chip:pointerover /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource FerriteHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FerriteBorder}" />
  </Style>

  <Style Selector="Button.chip:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource FerriteText}" />
  </Style>

  <!--
    Segmented control: a row of buttons that reads as one control. The first and last item round the
    outer corners; everything inside keeps square corners so the group looks continuous.
  -->
  <Style Selector="Button.segment">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FerriteTextMuted}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FontSize" Value="{DynamicResource FontMeta}" />
  </Style>

  <Style Selector="Button.segment:first-child">
    <Setter Property="CornerRadius" Value="6,0,0,6" />
  </Style>

  <Style Selector="Button.segment:last-child">
    <Setter Property="CornerRadius" Value="0,6,6,0" />
  </Style>

  <Style Selector="Button.segment:pointerover /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource FerriteHover}" />
  </Style>

  <Style Selector="Button.segment.active">
    <Setter Property="Foreground" Value="{DynamicResource FerriteText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.segment.active /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource FerriteSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FerriteBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!--
    Vertical sub-navigation for an instance. TabItem keeps the TabControl contract (SelectedIndex,
    keyboard traversal, automation peers) while presenting as a rail rather than a tab strip.
  -->
  <Style Selector="TabControl.subnav">
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="TabControl.subnav > TabItem">
    <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
    <Setter Property="Foreground" Value="{DynamicResource FerriteTextMuted}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root"
                Background="Transparent"
                CornerRadius="{DynamicResource RadiusMd}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
          </Border.Transitions>
          <Grid ColumnDefinitions="3,*">
            <Border Name="PART_Bar" Grid.Column="0" Width="3" Margin="1,6"
                    CornerRadius="2" Background="Transparent" />
            <ContentPresenter Name="PART_HeaderPresenter"
                              Grid.Column="1"
                              Margin="9,0,10,0"
                              Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              HorizontalContentAlignment="Left"
                              VerticalContentAlignment="Center"
                              RecognizesAccessKey="True" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="TabControl.subnav > TabItem:pointerover /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource FerriteHover}" />
  </Style>

  <Style Selector="TabControl.subnav > TabItem:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource FerriteText}" />
  </Style>

  <Style Selector="TabControl.subnav > TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource FerriteText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TabControl.subnav > TabItem:selected /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource FerriteAccentSoft}" />
  </Style>

  <Style Selector="TabControl.subnav > TabItem:selected /template/ Border#PART_Bar">
    <Setter Property="Background" Value="{DynamicResource FerriteAccent}" />
  </Style>

  <Style Selector="TabControl.subnav > TabItem:focus-visible /template/ Border#PART_Root">
    <Setter Property="BorderBrush" Value="{DynamicResource FerriteAccent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!--
    The instance sub-rail hides its TabControl chrome entirely: the rail is the navigation, and the
    content area is a plain panel.
  -->
  <Style Selector="TabControl.subnav /template/ ItemsPresenter#PART_ItemsPresenter">
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="TabControl.subnav /template/ Border#PART_SelectedPipe">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- Overlays -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource FerriteSurfaceOverlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FerriteBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="Foreground" Value="{DynamicResource FerriteText}" />
    <Setter Property="FontSize" Value="{DynamicResource FontMeta}" />
    <Setter Property="MaxWidth" Value="380" />
  </Style>

  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource FerriteSurfaceOverlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FerriteBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="4" />
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource FerriteText}" />
    <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
  </Style>

  <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource FerriteHover}" />
  </Style>

  <!-- Slimmer scrollbars so dense lists do not lose a column of width to chrome. -->
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource FerriteBorderStrong}" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="ScrollBar">
    <Setter Property="Opacity" Value="0.75" />
  </Style>

  <Style Selector="ScrollBar:pointerover">
    <Setter Property="Opacity" Value="1" />
  </Style>

</Styles>
