  <StreamGeometry x:Key="Icon.Upload">M12 20V9 M8 13l4-4 4 4 M4.5 4.5h15</StreamGeometry>
  <StreamGeometry x:Key="Icon.Link">M10 13.5a4 4 0 0 0 5.7 0l2.6-2.6a4 4 0 0 0-5.7-5.7L11.2 6.6 M14 10.5a4 4 0 0 0-5.7 0l-2.6 2.6a4 4 0 0 0 5.7 5.7l1.4-1.4</StreamGeometry>
