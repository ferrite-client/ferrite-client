  <StreamGeometry x:Key="Icon.Assistant">M12 3.5l1.7 4.3 4.3 1.7-4.3 1.7L12 15.5l-1.7-4.3L6 9.5l4.3-1.7z M18 16l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z</StreamGeometry>

