<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Ferrite icon set.

    Hand-authored geometry on a 24x24 grid: one stroke weight, round caps and joins, no fills except
    where a solid shape is the clearer read (play, stop, bolt). Authoring them here means the icons
    ship with the application under its own licence and stay visually consistent by construction.

    Usage: <Path Classes="icon" Data="{StaticResource Icon.Play}" />
  -->

  <!-- Navigation -->
  <StreamGeometry x:Key="Icon.Library">M4 4h7v7H4z M13 4h7v7h-7z M4 13h7v7H4z M13 13h7v7h-7z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Discover">M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z M15.6 8.4l-2.2 5.2-5.2 2.2 2.2-5.2z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Downloads">M12 4v10 M8 10.5l4 4 4-4 M4.5 19.5h15</StreamGeometry>
  <StreamGeometry x:Key="Icon.Settings">M4 8h16 M4 16h16 M9.5 6.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z M14.5 14.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Account">M12 11.5a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z M4.5 20.5a7.5 7.5 0 0 1 15 0</StreamGeometry>
  <StreamGeometry x:Key="Icon.Java">M6.5 9h8a3 3 0 0 1 0 6H8 M6.5 5.5h11 M5.5 20h13 M17.5 12h1.5v3a3 3 0 0 1-3 3</StreamGeometry>

