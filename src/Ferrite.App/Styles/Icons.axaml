  <StreamGeometry x:Key="Icon.Mods">M3.5 7.5L12 3l8.5 4.5v9L12 21l-8.5-4.5z M3.5 7.5L12 12l8.5-4.5 M12 12v9</StreamGeometry>
  <StreamGeometry x:Key="Icon.Content">M12 3l9 5-9 5-9-5z M3.5 12.5l8.5 4.7 8.5-4.7 M3.5 16.5l8.5 4.7 8.5-4.7</StreamGeometry>
  <StreamGeometry x:Key="Icon.World">M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z M3 12h18 M12 3c2.4 3.2 2.4 14.8 0 18 M12 3c-2.4 3.2-2.4 14.8 0 18</StreamGeometry>
  <StreamGeometry x:Key="Icon.Server">M4 4.5h16v6H4z M4 13.5h16v6H4z M7.5 7.5h.01 M7.5 16.5h.01</StreamGeometry>
