<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Ferrite palette: neutral graphite surfaces with a copper accent and a teal success tone.
    Two accents keep the interface from reading as a single-hue theme.
  -->
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="FerriteSurface" Color="#14161A" />
      <SolidColorBrush x:Key="FerriteSurfaceRaised" Color="#1B1E24" />
      <SolidColorBrush x:Key="FerriteSurfaceSunken" Color="#0F1114" />
      <SolidColorBrush x:Key="FerriteBorder" Color="#2A2F37" />
      <SolidColorBrush x:Key="FerriteBorderStrong" Color="#3A414B" />
      <SolidColorBrush x:Key="FerriteText" Color="#E8EAED" />
      <SolidColorBrush x:Key="FerriteTextMuted" Color="#9AA2AD" />
      <!--
        The faint tone is used at 12px, so it still has to clear WCAG AA (4.5:1) against both the
        page surface and the raised card surface.
      -->
      <SolidColorBrush x:Key="FerriteTextFaint" Color="#8C95A2" />
      <SolidColorBrush x:Key="FerriteAccent" Color="#D08A3E" />
      <SolidColorBrush x:Key="FerriteAccentHover" Color="#E0A458" />
      <SolidColorBrush x:Key="FerriteAccentText" Color="#1A1409" />
      <SolidColorBrush x:Key="FerriteSuccess" Color="#4FB3A5" />
      <SolidColorBrush x:Key="FerriteDanger" Color="#D2665C" />
      <SolidColorBrush x:Key="FerriteWarning" Color="#D8B04A" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="FerriteSurface" Color="#F6F6F4" />
      <SolidColorBrush x:Key="FerriteSurfaceRaised" Color="#FFFFFF" />
      <SolidColorBrush x:Key="FerriteSurfaceSunken" Color="#EAEAE6" />
      <SolidColorBrush x:Key="FerriteBorder" Color="#D6D6D0" />
      <SolidColorBrush x:Key="FerriteBorderStrong" Color="#BCBCB4" />
      <SolidColorBrush x:Key="FerriteText" Color="#1C1E22" />
      <SolidColorBrush x:Key="FerriteTextMuted" Color="#5A6068" />
      <SolidColorBrush x:Key="FerriteTextFaint" Color="#616870" />
      <SolidColorBrush x:Key="FerriteAccent" Color="#A5621B" />
      <SolidColorBrush x:Key="FerriteAccentHover" Color="#8E5215" />
      <SolidColorBrush x:Key="FerriteAccentText" Color="#FFFFFF" />
      <SolidColorBrush x:Key="FerriteSuccess" Color="#2B6F66" />
      <SolidColorBrush x:Key="FerriteDanger" Color="#B03A2E" />
      <SolidColorBrush x:Key="FerriteWarning" Color="#7C611B" />
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
